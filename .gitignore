# Arduino IDE
# ================================

# Arduino IDE 2.x build/cache files
.arduino/

# Compiled binaries and build artifacts
*.hex
*.elf
*.eep
*.map
*.bin

# Arduino IDE temporary files
*.tmp

# Backup files created by editors
*.bak
*~
*.swp
*.swo

# OS-specific files
# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini

# Linux
.directory

# IDE/editor files
.vscode/
.idea/

# Python cache (sometimes generated by Arduino tooling)
__pycache__/
*.pyc

# Serial monitor / log files
*.log